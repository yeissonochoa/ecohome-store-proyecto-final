{
  "name": "ecohome-store-backend",
  "version": "1.0.0",
  "description": "Backend RESTful beta-ready para EcoHome Store - Clean Architecture, PostgreSQL, JWT y RBAC",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/create-db.js",
    "db:init": "node scripts/init-db.js",
    "db:init:chat": "node scripts/run-sql.js db/migration_messages.sql",
    "db:init:traceability": "node scripts/run-sql.js db/migration_products_created_by.sql"
  },
  "keywords": ["ecommerce", "rest", "clean-architecture", "jwt", "postgresql"],
  "author": "EcoHome Store - Equipo Backend",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.7.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
